# Database
DATABASE_URL="postgresql://postgres:password@host:port/database"

# NextAuth
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Email Service
RESEND_API_KEY="re_your_resend_api_key"

# Stripe
STRIPE_SECRET_KEY="sk_test_or_live_key"
STRIPE_WEBHOOK_SECRET="whsec_webhook_secret"

# Tracking / Retargeting
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="1234567890123456"
NEXT_PUBLIC_LINKEDIN_PARTNER_ID="123456"
NEXT_PUBLIC_CLARITY_PROJECT_ID="abcd1234"
NEXT_PUBLIC_HOTJAR_ID="1234567"

# LinkedIn Conversions (Optional)
NEXT_PUBLIC_LINKEDIN_PURCHASE_ID="purchase_conversion_id"
NEXT_PUBLIC_LINKEDIN_LEAD_ID="lead_conversion_id"
NEXT_PUBLIC_LINKEDIN_DECK_ID="deck_download_conversion_id"
NEXT_PUBLIC_LINKEDIN_CONTACT_ID="contact_conversion_id"
NEXT_PUBLIC_LINKEDIN_SIGNUP_ID="signup_conversion_id"

# HubSpot CRM
HUBSPOT_API_KEY="pat-your-hubspot-private-app-token"
HUBSPOT_PORTAL_ID="your-portal-id"

# Instagram Automation (from your current system)
INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token"
INSTAGRAM_USER_ID="your_instagram_user_id"

# Anthropic API (for AI features)
ANTHROPIC_API_KEY="sk-ant-your-key"

# SEO — canonical URL (MUST match production domain, NOT the Railway internal domain)
# CRITICAL: NEXTAUTH_URL is used by Auth.js and may point to the Railway subdomain.
# Use NEXT_PUBLIC_SITE_URL exclusively for canonical/og:url/hreflang/sitemap.
NEXT_PUBLIC_SITE_URL="https://quetz.org"

# Google Search Console verification
# Get the code from: Search Console → Settings → Ownership verification → HTML tag
# Leave empty ("") to omit the metatag entirely (never set a placeholder value).
GOOGLE_SITE_VERIFICATION=""

# Post-purchase microsite & email
NEXT_PUBLIC_BASE_URL="https://quetz.org"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_public_token"
